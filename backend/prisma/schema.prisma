// ChaseHorse Outreach: multi-user lead intelligence & outreach platform.
// Every business record carries a userId and every query is scoped by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Provider {
  GEMINI
  ENRICHO
  GOOGLE
}

enum AuthType {
  API_KEY
  OAUTH
}

enum CredentialStatus {
  UNTESTED
  CONNECTED
  ERROR
}

enum DataSource {
  ENRICHO
  MANUAL
}

enum EmailStatus {
  NONE // no email on record
  UNVERIFIED // entered manually or unknown origin
  PROVIDER_FOUND // returned by the provider, with provider certainty in emailCertainty
}

enum LeadStage {
  NEW_LEAD
  RESEARCHING
  QUALIFIED
  CONTACTED
  FOLLOW_UP
  MEETING_SCHEDULED
  NEGOTIATION
  WON
  LOST
}

enum QualificationStatus {
  UNSCORED
  QUALIFIED
  NEEDS_REVIEW
  NOT_A_FIT
}

enum ScoreSource {
  AI
  MANUAL
}

enum ResearchStatus {
  COMPLETED
  FAILED
}

enum DraftStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
  DISCARDED
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailActivityType {
  SENT
  SEND_FAILED
  REPLY_RECEIVED
}

enum FollowUpKind {
  FOLLOW_UP
  CALL
  MEETING
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  OPEN
  DONE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

// ---------------------------------------------------------------------------
// Users, settings and credentials
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     UserSettings?
  credentials  IntegrationCredential[]
  oauthStates  OAuthState[]
  services     Service[]
  companies    Company[]
  contacts     Contact[]
  leads        Lead[]
  leadScores   LeadScore[]
  research     CompanyResearch[]
  activities   LeadActivity[]
  notes        Note[]
  tasks        Task[]
  followUps    FollowUp[]
  calendarEvts CalendarEvent[]
  campaigns    Campaign[]
  drafts       EmailDraft[]
  emailActs    EmailActivity[]
  suppression  SuppressionEntry[]
  providerLogs ProviderCallLog[]
  searchRuns   SearchRun[]
}

model UserSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Business context fed to the AI
  businessName           String   @default("ChaseHorse")
  businessDescription    String   @default("")
  valueProposition       String   @default("")
  idealCustomerProfile   String   @default("")
  // Sender identity
  senderName             String   @default("")
  senderTitle            String   @default("")
  signature              String   @default("")
  // AI defaults
  geminiModel            String   @default("gemini-2.5-flash")
  useSearchGrounding     Boolean  @default(true)
  defaultTone            String   @default("professional")
  defaultLength          String   @default("short")
  updatedAt              DateTime @updatedAt
}

model IntegrationCredential {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        Provider
  authType        AuthType
  // AES-256-GCM ciphertext. For API keys: the key. For OAuth: JSON token bundle.
  secretEncrypted String?
  // Non-secret display hint, e.g. "…a1b2"
  maskedHint      String?
  // Non-secret metadata: account email, granted scopes, discovered tools, etc.
  metadata        Json?
  status          CredentialStatus @default(UNTESTED)
  lastTestedAt    DateTime?
  lastError       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, provider])
}

model OAuthState {
  id            String   @id @default(uuid())
  state         String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      Provider
  // Encrypted PKCE verifier / transient data
  dataEncrypted String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Offerings the user sells (used as AI context)
model Service {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String
  valueProposition  String     @default("")
  targetIndustries  String[]
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  campaigns         Campaign[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Companies and contacts
// ---------------------------------------------------------------------------

model Company {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  domain          String?
  website         String?
  logoUrl         String?
  industry        String?
  industries      String[]
  categories      String[]
  description     String?
  employeeRange   String?
  revenueRange    String?
  foundedYear     Int?
  companyType     String?
  country         String?
  countryCode     String?
  state           String?
  city            String?
  address         String?
  phone           String?
  linkedinUrl     String?
  totalFunding    BigInt?
  fundingStage    String?
  fundingDate     DateTime?
  fundingRounds   Json?
  keywords        String[]
  technologies    String[]
  source          DataSource
  providerId      String?
  providerUpdatedAt DateTime?
  lastEnrichedAt  DateTime?
  lastResearchedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contacts        Contact[]
  leads           Lead[]
  research        CompanyResearch[]
  drafts          EmailDraft[]
  emailActs       EmailActivity[]
  activities      LeadActivity[]

  @@unique([userId, domain])
  @@unique([userId, providerId])
  @@index([userId, createdAt])
  @@index([userId, name])
}

model Contact {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName       String
  firstName      String?
  lastName       String?
  title          String?
  seniority      String?
  department     String?
  linkedinUrl    String?
  location       String?
  email          String?
  emailStatus    EmailStatus @default(NONE)
  emailCertainty String? // provider's own label for the email (Enricho: email_type), never a verification claim
  phone          String?
  source         DataSource
  providerId     String?
  lastEnrichedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  leadsPrimary   Lead[]          @relation("LeadPrimaryContact")
  drafts         EmailDraft[]
  emailActs      EmailActivity[]
  followUps      FollowUp[]
  activities     LeadActivity[]

  @@unique([userId, providerId])
  @@unique([companyId, email])
  @@index([userId, companyId])
  @@index([userId, email])
}

model CompanyResearch {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status       ResearchStatus
  model        String?
  grounded     Boolean        @default(false)
  // Structured, provenance-labelled sections (see research.service.ts)
  content      Json?
  sources      Json?
  errorMessage String?
  createdAt    DateTime       @default(now())

  @@index([userId, companyId, createdAt])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Lead {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryContactId    String?
  primaryContact      Contact?            @relation("LeadPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  stage               LeadStage           @default(NEW_LEAD)
  position            Int                 @default(0)
  owner               String?
  score               Int?
  qualificationStatus QualificationStatus @default(UNSCORED)
  scoreReasoning      String?
  outreachStrategy    String?
  scoreIsManual       Boolean             @default(false)
  estimatedValue      Int?
  lostReason          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  scores              LeadScore[]
  activities          LeadActivity[]
  notes               Note[]
  tasks               Task[]
  followUps           FollowUp[]
  drafts              EmailDraft[]
  emailActs           EmailActivity[]
  campaigns           CampaignLead[]
  calendarEvents      CalendarEvent[]

  @@unique([userId, companyId])
  @@index([userId, stage, position])
}

model LeadScore {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score     Int
  status    QualificationStatus
  reasoning String
  factors   Json?
  strategy  String?
  source    ScoreSource
  model     String?
  createdAt DateTime            @default(now())

  @@index([userId, leadId, createdAt])
}

model LeadActivity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type      String
  title     String
  details   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, status, dueDate])
}

model FollowUp {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  kind        FollowUpKind   @default(FOLLOW_UP)
  title       String
  notes       String?
  dueAt       DateTime
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  calendarEvent CalendarEvent?

  @@index([userId, status, dueAt])
}

model CalendarEvent {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpId    String?   @unique
  followUp      FollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  googleEventId String
  htmlLink      String?
  summary       String
  startAt       DateTime
  endAt         DateTime
  createdAt     DateTime  @default(now())

  @@unique([userId, googleEventId])
  @@index([userId, startAt])
}

model Campaign {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  objective   String
  description String?
  tone        String         @default("professional")
  status      CampaignStatus @default(DRAFT)
  serviceId   String?
  service     Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  leads       CampaignLead[]
  drafts      EmailDraft[]

  @@index([userId])
}

model CampaignLead {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([campaignId, leadId])
}

// ---------------------------------------------------------------------------
// Email
// ---------------------------------------------------------------------------

model EmailDraft {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId               String?
  lead                 Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaignId           String?
  campaign             Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  toEmail              String?
  subject              String
  body                 String
  tone                 String
  length               String
  objective            String?
  personalizationNotes String?
  generatedByAi        Boolean     @default(true)
  model                String?
  status               DraftStatus @default(DRAFT)
  approvedAt           DateTime?
  sentAt               DateTime?
  lastError            String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  activities           EmailActivity[]

  @@index([userId, status, updatedAt])
}

model EmailActivity {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftId        String?
  draft          EmailDraft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction      EmailDirection
  type           EmailActivityType
  gmailMessageId String?
  gmailThreadId  String?
  fromEmail      String
  toEmail        String
  subject        String
  snippet        String?
  error          String?
  occurredAt     DateTime          @default(now())

  @@unique([userId, gmailMessageId])
  @@index([userId, occurredAt])
  @@index([userId, gmailThreadId])
}

model SuppressionEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  domain    String?
  reason    String
  createdAt DateTime @default(now())

  @@unique([userId, email])
  @@unique([userId, domain])
}

// ---------------------------------------------------------------------------
// Observability
// ---------------------------------------------------------------------------

model ProviderCallLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider
  operation  String
  status     String // OK, AUTH_ERROR, RATE_LIMITED, CREDITS, UPSTREAM_ERROR, ...
  durationMs Int
  detail     String?
  createdAt  DateTime @default(now())

  @@index([userId, provider, createdAt])
}

model SearchRun {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String // COMPANY, PEOPLE
  filters        Json
  transport      String? // MCP or REST
  toolName       String?
  resultCount    Int      @default(0)
  totalAvailable Int?
  status         String
  error          String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}
