        "employee_size_band": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Company size bands, from 1-10 up to 10001+." },
        "country_code": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Headquarters country, ISO 3166-1 alpha-2." },
        "domain": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Exact domains." },
        "name": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Part of the company name." },
        "company_id": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Known company IDs." },
        "query": { "type": "string", "description": "Plain words; each must appear in name, domain, website, industry, country or address." },
        "exclude_company_ids": { "type": "array", "items": { "type": "string" } },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
        "cursor": { "type": "string" }
      }
    }
  },
