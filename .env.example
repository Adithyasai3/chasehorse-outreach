# ==============================================================================
# CHASEHORSE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# For Docker Compose: postgresql://postgres:postgres@localhost:5432/chasehorse?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chasehorse?schema=public

# Redis Configuration (BullMQ Background Processing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Encryption (32-character hex key for AES-256-GCM token encryption at rest)
ENCRYPTION_SECRET=4f9c8d2e1a3b5c7e9f0a2b4c6d8e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e
JWT_SECRET=super-secret-jwt-key-chasehorse-platform-2026

# Google Gemini AI Integration
# Get API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Enricho MCP Integration
# Server URL: https://mcp.enricho.co/mcp
ENRICHO_MCP_URL=https://mcp.enricho.co/mcp
ENRICHO_API_KEY=your_enricho_api_key_or_token_here
ENRICHO_SIMULATION_MODE=false

# Google OAuth 2.0 & Gmail API Integration
# Setup in Google Cloud Console -> APIs & Services -> Credentials
# Required Scopes: gmail.readonly, gmail.send, gmail.compose, userinfo.email
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback

# Background Sync Settings
GMAIL_SYNC_INTERVAL_MINUTES=5
MAX_SEARCH_RESULTS_PER_BATCH=10
