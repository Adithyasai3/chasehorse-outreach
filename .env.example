# ==============================================================================
# ChaseHorse Outreach: application-level configuration.
# Copy to .env and fill in. Never commit .env.
#
# Per-user API keys (Gemini, Enricho) are NOT configured here. Each user adds
# their own keys in the app under Settings → Integrations; they are stored
# encrypted in PostgreSQL with ENCRYPTION_KEY.
# ==============================================================================

NODE_ENV=development
PORT=5000

# Public URL of the web app. The frontend proxies /api/* to the backend, so OAuth
# redirect URIs live under this origin (see README → OAuth setup).
APP_URL=http://localhost:3000

# PostgreSQL (docker-compose maps the container to host port 5434)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/chasehorse?schema=public

# Redis (docker-compose maps the container to host port 6381)
REDIS_URL=redis://localhost:6381

# 64 hex characters (32 bytes). Encrypts users' API keys and OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes previously stored credentials unreadable (users must re-enter them).
ENCRYPTION_KEY=

# At least 32 characters. Signs session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google OAuth client (Gmail + Calendar). Create a "Web application" OAuth client in
# Google Cloud Console and add this authorized redirect URI:
#   http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enricho MCP endpoint (default shown). See https://docs.enricho.co/connect
ENRICHO_MCP_URL=https://mcp.enricho.co/mcp

# How often to check Gmail threads of sent outreach for replies
GMAIL_SYNC_INTERVAL_MINUTES=10
